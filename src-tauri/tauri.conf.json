{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WB Tax Base - УСН 6%",
  "version": "0.1.0",
  "identifier": "ru.wb.taxbase.usn6",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WB Tax Base - УСН 6%",
        "width": 1400,
        "height": 900,
        "resizable": false,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
